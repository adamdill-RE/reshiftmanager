# Rodeo Express — public document root (deployed to public_html/resm/).
#
# LiteSpeed reads Apache-syntax .htaccess, but two Apache habits do not carry
# over under LSAPI (docs/hosting.md): php_value and php_flag lines are ignored,
# and anything wrapped in <IfModule mod_php*> never fires. PHP settings belong
# in MultiPHP INI Editor, not here. Nothing below sets one.

Options -Indexes
DirectoryIndex index.php

# Everything that is not a real file goes to the front controller.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # No RewriteBase on purpose. In a per-directory .htaccess a relative
    # substitution is resolved against the directory the file sits in, so this
    # works unchanged whether the app is mounted at /resm/ or anywhere else,
    # and there is no second place to keep the mount point in sync.

    # Serve existing files and directories as they are — assets, mainly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

# Dotfiles are never content.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Assets carry a ?v=<mtime> stamp from App::asset(), so a long cache is safe
# and a changed file busts itself. This is most of the first-contentful-paint
# budget on 3G (spec 10.6).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"

    # The shell itself must never be cached, or a deploy would not be visible.
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# The service worker is the one .js file that must NOT inherit the year above.
#
# It is served from /resm/ rather than assets/ so that its default scope is the
# whole application, which also means the rule above would otherwise pin a
# year's cache on the file that decides what everything else caches. A worker
# frozen for a year would keep serving a shell from a deploy nobody can
# replace — the exact failure the ?v= stamp in its registration URL exists to
# prevent, reintroduced one layer down.
#
# Browsers already cap a worker script's own freshness at 24 hours, but that is
# their courtesy and not this server's instruction. This is the instruction.
<Files "sw.js">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </IfModule>
</Files>
