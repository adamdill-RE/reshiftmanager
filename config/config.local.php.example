<?php

declare(strict_types=1);

/**
 * Copy to config.local.php and fill in. This file is gitignored: it is where
 * credentials live, and on the server it sits outside public_html so it is not
 * web-readable.
 *
 * Only the keys you want to override need to be present; everything else falls
 * back to config/config.php.
 */
return [
    'app' => [
        // Guards /status. Generate one with:
        //   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
        // Without it, /status returns 404 for everyone.
        'status_key' => '',

        // Guards /setup, which runs migrations and sets an administrator's PIN
        // from a browser — the only way to do either without shell access.
        // Generate it the same way as status_key.
        //
        // Whoever holds this can take the master admin account. Set it when
        // you need it, then REMOVE THIS LINE once the app is running: with no
        // key configured, /setup does not exist.
        'setup_key' => '',

        // Never true on the server.
        'debug' => false,
    ],

    'db' => [
        // cPanel prefixes database and user names with the account name.
        'host' => 'localhost',
        'name' => 'reshiftmanager_resm',
        'user' => 'reshiftmanager_resm',
        'pass' => '',
    ],
];
